<Application x:Class="Scribo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Scribo">
    <Application.Resources>
        <!-- Neo-Pop Cartoon & Comic Palette (Dedicated 2D Light Theme) -->
        <SolidColorBrush x:Key="ToolbarBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolBtnBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ToolBtnBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ToolBtnHoverBg" Color="#FEF08A"/>
        <SolidColorBrush x:Key="ToolBtnHoverBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolBtnPressedBg" Color="#FDE047"/>
        <SolidColorBrush x:Key="ToolBtnFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolBtnHoverFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolActiveBg" Color="#FFE600"/>
        <SolidColorBrush x:Key="ToolActiveBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolActiveFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PopupBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="PopupTitleFg" Color="#4F46E5"/>
        <SolidColorBrush x:Key="PopupItemBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PopupItemBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PopupItemHoverBg" Color="#FEF08A"/>
        <SolidColorBrush x:Key="PopupItemHoverBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="PopupTextFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="PopupSubtextFg" Color="#64748B"/>
        <SolidColorBrush x:Key="PopupIconStroke" Color="#0F172A"/>
        <SolidColorBrush x:Key="SwatchEdgeStroke" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BadgeBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BadgeTextFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="PresetDotFg" Color="#0F172A"/>
    </Application.Resources>
</Application>
