<Window x:Class="Scribo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scribo"
        Icon="app.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Neo-Pop Cartoon & Comic Palette (Dedicated 2D Light Theme) -->
        <SolidColorBrush x:Key="ToolbarBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToolbarBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolBtnBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ToolBtnBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ToolBtnHoverBg" Color="#FEF08A"/>
        <SolidColorBrush x:Key="ToolBtnHoverBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolBtnPressedBg" Color="#FDE047"/>
        <SolidColorBrush x:Key="ToolBtnFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolBtnHoverFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolActiveBg" Color="#FFE600"/>
        <SolidColorBrush x:Key="ToolActiveBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="ToolActiveFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="SeparatorBrush" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PopupBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PopupBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="PopupTitleFg" Color="#4F46E5"/>
        <SolidColorBrush x:Key="PopupItemBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="PopupItemBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PopupItemHoverBg" Color="#FEF08A"/>
        <SolidColorBrush x:Key="PopupItemHoverBorder" Color="#0F172A"/>
        <SolidColorBrush x:Key="PopupTextFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="PopupSubtextFg" Color="#64748B"/>
        <SolidColorBrush x:Key="PopupIconStroke" Color="#0F172A"/>
        <SolidColorBrush x:Key="SwatchEdgeStroke" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BadgeBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BadgeTextFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="PresetDotFg" Color="#0F172A"/>

        <!-- Neo-Pop 2D Cartoon Slider Styles -->
        <Style x:Key="NeoPopSliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder"
                                Width="14" Height="14"
                                Background="#FFE600"
                                BorderBrush="#0F172A"
                                BorderThickness="2"
                                CornerRadius="7"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#FACC15"/>
                                <Setter TargetName="thumbBorder" Property="BorderBrush" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#FEF08A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeoPopSliderStyle" TargetType="Slider">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6"
                                    Background="#E2E8F0"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NeoPopSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neo-Pop Cartoon Button Style -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolBtnHoverFg}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.12"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.12"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="0,2,0,-2"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnPressedBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neo-Pop Cartoon Tool Radio Button Style -->
        <Style x:Key="ToolRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter x:Name="content"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform Y="0"/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolBtnHoverFg}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.12"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.12"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0"
                                                             Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="0,2,0,-2"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnPressedBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolActiveBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolActiveBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolActiveFg}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             From="0.92" To="1.0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.8" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             From="0.92" To="1.0"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.8" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neo-Pop Stroke Size Radio Button Style -->
        <Style x:Key="SizeRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource PresetDotFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.15" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.15" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="0,1,0,-1"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolActiveBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolActiveBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolActiveFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neo-Pop Shape Menu Item Style -->
        <Style x:Key="ShapeMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PopupItemBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PopupItemBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PopupItemHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PopupItemHoverBorder}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.04" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.04" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="0,1,0,-1"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PopupItemBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shape Option RadioButton Style for the Horizontal Mini-Bar -->
        <Style x:Key="ShapeOptionButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolBtnHoverFg}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.12" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.12" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolActiveBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolActiveBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolActiveFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="0,1,0,-1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Format Toggle Button Style (Bold, Italic, Underline) -->
        <Style x:Key="TextStyleToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="4,4"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolBtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolActiveBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolActiveBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolActiveFg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="0,1,0,-1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neo-Pop Color Swatch Style with Bouncy Spring Animation -->
        <Style x:Key="ProColorSwatchStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="GroupName" Value="ProColors"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="swatchCard"
                                    Background="Transparent"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- Outer Selection Accent Ring -->
                                    <Ellipse x:Name="outerRing"
                                             Width="32" Height="32"
                                             Stroke="Transparent"
                                             StrokeThickness="2"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                    <!-- Color Swatch Circle -->
                                    <Ellipse x:Name="colorCircle"
                                             Width="24" Height="24"
                                             Fill="{TemplateBinding Background}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                    <!-- Permanent Inked Edge Stroke -->
                                    <Ellipse x:Name="edgeBorder"
                                             Width="24" Height="24"
                                             Stroke="{DynamicResource SwatchEdgeStroke}"
                                             StrokeThickness="1.5"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerRing" Property="Stroke" Value="{DynamicResource ToolBtnHoverBorder}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="swatchCard"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.18" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.7" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="swatchCard"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.18" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.7" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="swatchCard"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="swatchCard"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="swatchCard" Property="Margin" Value="0,2,0,-2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerRing" Property="Stroke" Value="#0F172A"/>
                                <Setter TargetName="outerRing" Property="StrokeThickness" Value="2.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neo-Pop Color Style Toggle Button Style -->
        <Style x:Key="ColorStyleToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolBtnHoverFg}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.6" EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="border"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Margin" Value="0,2,0,-2"/>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnPressedBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolActiveBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Presentation Toggle Button Style (Spotlight & Magnifier) -->
        <Style x:Key="PresentationToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ToolBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolBtnBorder}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="11"
                                    Padding="{TemplateBinding Padding}"
                                    RenderTransformOrigin="0.5,0.5"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolBtnHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource ToolBtnHoverBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ToolBtnHoverFg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE600"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shape Option Toggle Style (Fill Shapes) -->
        <Style x:Key="ShapeOptionToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource PopupItemBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PopupItemBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ToolBtnFg}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource PopupItemHoverBg}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FFE600"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal Separator -->
        <Style x:Key="HSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Fill" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- Vertical Separator -->
        <Style x:Key="VSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="1.5"/>
            <Setter Property="Fill" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Hard 2D Shadow padding -->
    <Grid Margin="18">
        <Border x:Name="toolbarBorder"
                Background="{DynamicResource ToolbarBg}"
                BorderBrush="{DynamicResource ToolbarBorder}"
                BorderThickness="2"
                CornerRadius="20"
                Padding="8,5">
            <Border.Effect>
                <DropShadowEffect x:Name="toolbarShadow" BlurRadius="0" ShadowDepth="5" Direction="315" Color="#0F172A" Opacity="0.30"/>
            </Border.Effect>

            <StackPanel x:Name="toolbarPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Playful 2D Drag Handle -->
                <Border x:Name="dragHandleBorder"
                        Background="{DynamicResource ToolBtnBg}"
                        BorderBrush="{DynamicResource ToolBtnBorder}"
                        BorderThickness="1.5"
                        Cursor="SizeAll"
                        Padding="5,6"
                        CornerRadius="9"
                        Margin="1,0,3,0"
                        HorizontalAlignment="Center"
                        ToolTip="Drag Scribo anywhere on screen"
                        MouseDown="DragHandle_MouseDown">
                    <StackPanel x:Name="dragHandleStack" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel x:Name="dragDotsCol1" Orientation="Vertical" Margin="0,0,2.5,0">
                            <Ellipse Width="3" Height="3" Fill="#38BDF8" Margin="0,1.5"/>
                            <Ellipse Width="3" Height="3" Fill="#F472B6" Margin="0,1.5"/>
                            <Ellipse Width="3" Height="3" Fill="#FACC15" Margin="0,1.5"/>
                        </StackPanel>
                        <StackPanel x:Name="dragDotsCol2" Orientation="Vertical">
                            <Ellipse Width="3" Height="3" Fill="#38BDF8" Margin="0,1.5"/>
                            <Ellipse Width="3" Height="3" Fill="#F472B6" Margin="0,1.5"/>
                            <Ellipse Width="3" Height="3" Fill="#FACC15" Margin="0,1.5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Separator -->
                <Rectangle x:Name="sep0" Style="{StaticResource HSeparatorStyle}"/>

                <!-- Drawing Tools Group -->
                <StackPanel x:Name="toolsPanel" Orientation="Horizontal">
                    <!-- Select & Move -->
                    <RadioButton x:Name="toolSelect"
                                 GroupName="DrawingTools"
                                 Style="{StaticResource ToolRadioButtonStyle}"
                                 PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown"
                                 Click="Tool_Click"
                                 ToolTip="Select &amp; Move (S) — Click or lasso to select, then drag to move shapes/drawings anywhere on screen">
                        <Image Source="icon/move-selection.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    </RadioButton>

                    <!-- Pen -->
                    <RadioButton x:Name="toolPen"
                                 GroupName="DrawingTools"
                                 Style="{StaticResource ToolRadioButtonStyle}"
                                 PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown"
                                 Click="Tool_Click"
                                 ToolTip="Pen (P) — Click to draw, click again for cursor mode">
                        <Image Source="icon/pen.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    </RadioButton>

                    <!-- Highlighter -->
                    <RadioButton x:Name="toolHighlighter"
                                 GroupName="DrawingTools"
                                 Style="{StaticResource ToolRadioButtonStyle}"
                                 PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown"
                                 Click="Tool_Click"
                                 ToolTip="Highlighter (H) — Click to draw, click again for cursor mode">
                        <Image Source="icon/highlighter.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    </RadioButton>

                    <!-- Laser Pointer -->
                    <RadioButton x:Name="toolLaser"
                                 GroupName="DrawingTools"
                                 Style="{StaticResource ToolRadioButtonStyle}"
                                 PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown"
                                 Click="Tool_Click"
                                 ToolTip="Laser Pointer (L) — Click to draw, click again for cursor mode">
                        <Path Data="M7 2v11h3v9l7-12h-4l4-8z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform"/>
                    </RadioButton>

                    <!-- Text Note (Split Button: Text Tool + Dropdown Chevron) -->
                    <Grid x:Name="textContainer" VerticalAlignment="Center">
                        <StackPanel x:Name="textButtonPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Main Text Tool Button -->
                            <RadioButton x:Name="toolText"
                                         GroupName="DrawingTools"
                                         Style="{StaticResource ToolRadioButtonStyle}"
                                         PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown"
                                         Click="Tool_Click"
                                         MouseRightButtonUp="ToolText_RightClick"
                                         ToolTip="Text Tool (T) — Click to type, arrow for font &amp; styles"
                                         Margin="2,0,1,0"
                                         Padding="7">
                                <Image Source="icon/text.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                            </RadioButton>

                            <!-- Dropdown Chevron Button -->
                            <Button x:Name="btnTextDropdown"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="BtnTextDropdown_Click"
                                    ToolTip="Text Formatting (Font, Size, Bold, Italic, Underline)"
                                    Margin="0,0,2,0"
                                    Padding="4,7"
                                    Width="18"
                                    MinWidth="18">
                                <Path x:Name="chevronText"
                                      Data="M1 1.5L4 4.5L7 1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="7" Height="5"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Text Formatting Popover Flyout -->
                        <Popup x:Name="textPopup"
                               PlacementTarget="{Binding ElementName=textContainer}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               PopupAnimation="None"
                               VerticalOffset="8">
                            <Border x:Name="textPopupBorder"
                                    Background="{DynamicResource PopupBg}"
                                    BorderBrush="{DynamicResource PopupBorder}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Padding="12"
                                    Width="248">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="textShadow" BlurRadius="0" ShadowDepth="5" Direction="315" Color="#0F172A" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Section Title -->
                                    <TextBlock Text="TEXT FORMATTING" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource PopupTitleFg}" Margin="2,0,0,8" SnapsToDevicePixels="True"/>

                                    <!-- Font Family Dropdown -->
                                    <TextBlock Text="FONT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PopupTitleFg}" Margin="2,0,0,4"/>
                                    <ComboBox x:Name="comboFontFamily"
                                              Height="28"
                                              Background="#FFFFFF"
                                              Foreground="#0F172A"
                                              BorderBrush="#CBD5E1"
                                              BorderThickness="1.5"
                                              FontSize="12"
                                              Padding="6,3"
                                              Margin="0,0,0,8"
                                              SelectionChanged="ComboFont_SelectionChanged">
                                        <ComboBoxItem Content="Segoe UI" FontFamily="Segoe UI" Tag="Segoe UI" IsSelected="True"/>
                                        <ComboBoxItem Content="Arial" FontFamily="Arial" Tag="Arial"/>
                                        <ComboBoxItem Content="Calibri" FontFamily="Calibri" Tag="Calibri"/>
                                        <ComboBoxItem Content="Consolas (Code)" FontFamily="Consolas" Tag="Consolas"/>
                                        <ComboBoxItem Content="Comic Sans MS" FontFamily="Comic Sans MS" Tag="Comic Sans MS"/>
                                        <ComboBoxItem Content="Impact" FontFamily="Impact" Tag="Impact"/>
                                        <ComboBoxItem Content="Times New Roman" FontFamily="Times New Roman" Tag="Times New Roman"/>
                                        <ComboBoxItem Content="Georgia" FontFamily="Georgia" Tag="Georgia"/>
                                        <ComboBoxItem Content="Trebuchet MS" FontFamily="Trebuchet MS" Tag="Trebuchet MS"/>
                                        <ComboBoxItem Content="Verdana" FontFamily="Verdana" Tag="Verdana"/>
                                    </ComboBox>

                                    <!-- Font Size & Steppers -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SIZE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PopupTitleFg}" Margin="2,0,0,4"/>
                                            <ComboBox x:Name="comboFontSize"
                                                      Height="28"
                                                      Background="#FFFFFF"
                                                      Foreground="#0F172A"
                                                      BorderBrush="#CBD5E1"
                                                      BorderThickness="1.5"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"
                                                      Padding="6,3"
                                                      SelectionChanged="ComboFontSize_SelectionChanged">
                                                <ComboBoxItem Content="14 px" Tag="14"/>
                                                <ComboBoxItem Content="18 px" Tag="18"/>
                                                <ComboBoxItem Content="24 px (Default)" Tag="24" IsSelected="True"/>
                                                <ComboBoxItem Content="32 px" Tag="32"/>
                                                <ComboBoxItem Content="40 px" Tag="40"/>
                                                <ComboBoxItem Content="48 px" Tag="48"/>
                                                <ComboBoxItem Content="64 px" Tag="64"/>
                                                <ComboBoxItem Content="72 px" Tag="72"/>
                                                <ComboBoxItem Content="96 px" Tag="96"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Stepper Buttons (A- and A+) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                                            <Button x:Name="btnFontDec"
                                                    Style="{StaticResource ToolbarButtonStyle}"
                                                    Click="BtnFontDec_Click"
                                                    ToolTip="Decrease Font Size"
                                                    Width="28" Height="28" Padding="0"
                                                    Margin="0,0,4,0">
                                                <TextBlock Text="A-" FontSize="11" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button x:Name="btnFontInc"
                                                    Style="{StaticResource ToolbarButtonStyle}"
                                                    Click="BtnFontInc_Click"
                                                    ToolTip="Increase Font Size"
                                                    Width="28" Height="28" Padding="0">
                                                <TextBlock Text="A+" FontSize="11" FontWeight="Bold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Style Toggles: Bold, Italic, Underline -->
                                    <TextBlock Text="STYLE" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource PopupTitleFg}" Margin="2,0,0,4"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                        <!-- Bold Toggle -->
                                        <ToggleButton x:Name="btnTextBold"
                                                      Style="{StaticResource TextStyleToggleButtonStyle}"
                                                      Click="TextStyleToggle_Click"
                                                      IsChecked="True"
                                                      ToolTip="Bold (Ctrl+B)"
                                                      Margin="2,0">
                                            <TextBlock Text="B" FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ToggleButton>

                                        <!-- Italic Toggle -->
                                        <ToggleButton x:Name="btnTextItalic"
                                                      Style="{StaticResource TextStyleToggleButtonStyle}"
                                                      Click="TextStyleToggle_Click"
                                                      ToolTip="Italic (Ctrl+I)"
                                                      Margin="2,0">
                                            <TextBlock Text="I" FontSize="13" FontStyle="Italic" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ToggleButton>

                                        <!-- Underline Toggle -->
                                        <ToggleButton x:Name="btnTextUnderline"
                                                      Style="{StaticResource TextStyleToggleButtonStyle}"
                                                      Click="TextStyleToggle_Click"
                                                      ToolTip="Underline (Ctrl+U)"
                                                      Margin="2,0">
                                            <TextBlock Text="U" FontSize="13" FontWeight="Bold" TextDecorations="Underline" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </ToggleButton>
                                    </UniformGrid>

                                    <!-- Live Preview Box -->
                                    <Border Background="{DynamicResource ToolBtnBg}"
                                            BorderBrush="{DynamicResource ToolBtnBorder}"
                                            BorderThickness="1.5"
                                            CornerRadius="8"
                                            Padding="8,6"
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="txtFontPreview"
                                                   Text="Aa Preview (123)"
                                                   FontSize="14"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Numbered Step Badge -->
                    <RadioButton x:Name="toolBadge"
                                 GroupName="DrawingTools"
                                 Style="{StaticResource ToolRadioButtonStyle}"
                                 PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown"
                                 Click="Tool_Click"
                                 ToolTip="Step Badge (N) — Click to place numbered steps (①, ②, ③...). Right-click to reset sequence to 1">
                        <Grid Width="16" Height="16">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                     StrokeThickness="1.8"/>
                            <TextBlock Text="1"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,-0.5,0,0"/>
                        </Grid>
                    </RadioButton>

                    <!-- Shapes (Split Button: Shape Tool + Dropdown Chevron) -->
                    <Grid x:Name="shapesContainer" VerticalAlignment="Center">
                        <StackPanel x:Name="shapesButtonPanel" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Main Shape Tool Button -->
                            <RadioButton x:Name="toolShapes"
                                         GroupName="DrawingTools"
                                         Style="{StaticResource ToolRadioButtonStyle}"
                                         PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown"
                                         Click="Tool_Click"
                                         MouseRightButtonUp="ToolShapes_RightClick"
                                         ToolTip="Shape Tool — Click to draw current shape, click again for cursor mode"
                                         Margin="2,0,1,0"
                                         Padding="7">
                                <ContentControl x:Name="shapeIconPresenter" VerticalAlignment="Center" Background="Transparent">
                                    <Rectangle Width="14" Height="14"
                                               Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                               Fill="Transparent"
                                               StrokeThickness="2" SnapsToDevicePixels="True"/>
                                </ContentControl>
                            </RadioButton>

                            <!-- Dropdown Chevron Button -->
                            <Button x:Name="btnShapesDropdown"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="BtnShapesDropdown_Click"
                                    ToolTip="Choose Shape (Rectangle, Circle, Arrow, Line, Fill...)"
                                    Margin="0,0,2,0"
                                    Padding="4,7"
                                    Width="18"
                                    MinWidth="18">
                                <Path x:Name="chevronShapes"
                                      Data="M1 1.5L4 4.5L7 1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="7" Height="5"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <!-- Shapes Horizontal Mini-Bar Flyout -->
                        <Popup x:Name="shapesPopup"
                               PlacementTarget="{Binding ElementName=shapesContainer}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               PopupAnimation="None"
                               VerticalOffset="8">
                            <Border x:Name="shapesPopupBorder"
                                    Background="{DynamicResource PopupBg}"
                                    BorderBrush="{DynamicResource PopupBorder}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Padding="5">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="shapesShadow" BlurRadius="0" ShadowDepth="4" Direction="315" Color="#0F172A" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Rectangle -->
                                    <RadioButton x:Name="btnShapeRect"
                                                 GroupName="ShapeFlyout"
                                                 Style="{StaticResource ShapeOptionButtonStyle}"
                                                 Click="BtnShapeSelect_Click"
                                                 Tag="Rectangle"
                                                 IsChecked="True"
                                                 ToolTip="Rectangle">
                                        <Rectangle Width="14" Height="14"
                                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                   StrokeThickness="2" SnapsToDevicePixels="True"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </RadioButton>

                                    <!-- Circle -->
                                    <RadioButton x:Name="btnShapeCircle"
                                                 GroupName="ShapeFlyout"
                                                 Style="{StaticResource ShapeOptionButtonStyle}"
                                                 Click="BtnShapeSelect_Click"
                                                 Tag="Circle"
                                                 ToolTip="Circle">
                                        <Ellipse Width="14" Height="14"
                                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                 StrokeThickness="2" SnapsToDevicePixels="True"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </RadioButton>

                                    <!-- Arrow -->
                                    <RadioButton x:Name="btnShapeArrow"
                                                 GroupName="ShapeFlyout"
                                                 Style="{StaticResource ShapeOptionButtonStyle}"
                                                 Click="BtnShapeSelect_Click"
                                                 Tag="Arrow"
                                                 ToolTip="Single Arrow">
                                        <Path Data="M3.5 14.5L14.5 3.5M7.5 5.5L14.5 3.5L12.5 10.5"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="14" Stretch="Uniform" SnapsToDevicePixels="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </RadioButton>

                                    <!-- Double Arrow -->
                                    <RadioButton x:Name="btnShapeDoubleArrow"
                                                 GroupName="ShapeFlyout"
                                                 Style="{StaticResource ShapeOptionButtonStyle}"
                                                 Click="BtnShapeSelect_Click"
                                                 Tag="DoubleArrow"
                                                 ToolTip="Double Arrow">
                                        <Path Data="M2 12L12 2M6 2L2 2L2 6M8 12L12 12L12 8"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="14" Height="14" Stretch="Uniform" SnapsToDevicePixels="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </RadioButton>

                                    <!-- Straight Line -->
                                    <RadioButton x:Name="btnShapeLine"
                                                 GroupName="ShapeFlyout"
                                                 Style="{StaticResource ShapeOptionButtonStyle}"
                                                 Click="BtnShapeSelect_Click"
                                                 Tag="Line"
                                                 ToolTip="Straight Line">
                                        <Line X1="2" Y1="12" X2="12" Y2="2"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="14" Height="14" SnapsToDevicePixels="True"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </RadioButton>

                                    <!-- Separator between shapes and fill option -->
                                    <Rectangle Width="1.5" Height="16" Fill="{DynamicResource SeparatorBrush}" Margin="4,0" VerticalAlignment="Center"/>

                                    <!-- Fill Shape Toggle -->
                                    <ToggleButton x:Name="btnFillShape"
                                                  Style="{StaticResource ShapeOptionToggleStyle}"
                                                  Click="BtnFillShape_Click"
                                                  ToolTip="Fill Shapes — Semi-transparent color fill for boxes and circles">
                                        <Grid Width="14" Height="14">
                                            <Rectangle Width="13" Height="13"
                                                       Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                       StrokeThickness="1.5"
                                                       Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                       Opacity="0.45"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Eraser -->
                    <RadioButton x:Name="toolEraser"
                                 GroupName="DrawingTools"
                                 Style="{StaticResource ToolRadioButtonStyle}"
                                 PreviewMouseLeftButtonDown="Tool_PreviewMouseLeftButtonDown"
                                 Click="Tool_Click"
                                 ToolTip="Stroke Eraser (E) — Click to erase, click again for cursor mode">
                        <Image Source="icon/eraser.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    </RadioButton>
                </StackPanel>

                <!-- Separator -->
                <Rectangle x:Name="sep1" Style="{StaticResource HSeparatorStyle}"/>

                <!-- Professional Color Palette Button & Flyout -->
                <Grid x:Name="colorStyleContainer" VerticalAlignment="Center">
                    <ToggleButton x:Name="btnColorStyle"
                                  Style="{StaticResource ColorStyleToggleButtonStyle}"
                                  Click="BtnColorStyle_Click"
                                  ToolTip="Color Palette">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Color Wheel Icon with Active Color Dot Indicator -->
                            <Grid VerticalAlignment="Center">
                                <Image Source="icon/color-wheel.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                                <Border Width="7" Height="7" CornerRadius="3.5" BorderBrush="#0F172A" BorderThickness="1.2"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                                        SnapsToDevicePixels="True">
                                    <Ellipse x:Name="activeColorBadge" Fill="#FFE600"/>
                                </Border>
                            </Grid>
                            <!-- Dropdown Chevron -->
                            <Path x:Name="chevronColor"
                                  Data="M1 1.5L4 4.5L7 1.5"
                                  Stroke="{DynamicResource ToolBtnFg}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="7" Height="5"
                                  Stretch="Uniform"
                                  Margin="5,1,1,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Professional Palette Popover -->
                    <Popup x:Name="colorStylePopup"
                           PlacementTarget="{Binding ElementName=btnColorStyle}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           PopupAnimation="None"
                           Closed="ColorStylePopup_Closed"
                           VerticalOffset="8">
                        <Border x:Name="colorStyleBorder"
                                Background="{DynamicResource PopupBg}"
                                BorderBrush="{DynamicResource PopupBorder}"
                                BorderThickness="2"
                                CornerRadius="16"
                                Padding="12"
                                Width="194">
                            <Border.Effect>
                                <DropShadowEffect x:Name="paletteShadow" BlurRadius="0" ShadowDepth="6" Direction="315" Color="#0F172A" Opacity="0.30"/>
                            </Border.Effect>

                            <StackPanel>
                                <TextBlock x:Name="lblColorPaletteTitle" Text="COLOR PALETTE" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource PopupTitleFg}" Margin="2,0,0,8" SnapsToDevicePixels="True"/>

                                <!-- Curated 12-Color Professional Grid (3 rows of 4) -->
                                <UniformGrid Columns="4" Margin="0,0,0,2">
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#FFE600" Tag="#FFE600" ToolTip="Electric Yellow" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click" IsChecked="True"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#FF3B5C" Tag="#FF3B5C" ToolTip="Coral Red" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#FB923C" Tag="#FB923C" ToolTip="Sunset Orange" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#00E676" Tag="#00E676" ToolTip="Neon Green" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#00D2FF" Tag="#00D2FF" ToolTip="Electric Cyan" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#3B82F6" Tag="#3B82F6" ToolTip="Royal Blue" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#C084FC" Tag="#C084FC" ToolTip="Vivid Lavender" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#EC4899" Tag="#EC4899" ToolTip="Hot Pink" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#FFFFFF" Tag="#FFFFFF" ToolTip="Clean White" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#94A3B8" Tag="#94A3B8" ToolTip="Silver Gray" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#475569" Tag="#475569" ToolTip="Slate" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                    <RadioButton Style="{StaticResource ProColorSwatchStyle}" Background="#0F172A" Tag="#0F172A" ToolTip="Carbon Black" PreviewMouseLeftButtonDown="Color_PreviewMouseDown" Click="Color_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Separator -->
                <Rectangle x:Name="sep2" Style="{StaticResource HSeparatorStyle}"/>

                <!-- Professional Stroke Thickness Button & Horizontal Mini-Bar Flyout -->
                <Grid x:Name="thicknessContainer" VerticalAlignment="Center">
                    <ToggleButton x:Name="btnThickness"
                                  Style="{StaticResource ColorStyleToggleButtonStyle}"
                                  Click="BtnThickness_Click"
                                  ToolTip="Stroke Thickness (5px)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Current Thickness Preview Badge (Dynamic Dot) -->
                            <Border Width="18" Height="18" CornerRadius="9" BorderBrush="{DynamicResource BadgeBorder}" Background="{DynamicResource BadgeBg}" BorderThickness="1.5" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                <Ellipse x:Name="activeThicknessDot" Width="6" Height="6" Fill="{DynamicResource ToolBtnFg}"/>
                            </Border>
                            <!-- Dropdown Chevron -->
                            <Path x:Name="chevronThickness"
                                  Data="M1 1.5L4 4.5L7 1.5"
                                  Stroke="{DynamicResource ToolBtnFg}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="7" Height="5"
                                  Stretch="Uniform"
                                  Margin="5,1,1,0"
                                  VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Thickness Horizontal Mini-Bar Popup -->
                    <Popup x:Name="thicknessPopup"
                           PlacementTarget="{Binding ElementName=btnThickness}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           PopupAnimation="None"
                           VerticalOffset="8">
                        <Border x:Name="thicknessPopupBorder"
                                Background="{DynamicResource PopupBg}"
                                BorderBrush="{DynamicResource PopupBorder}"
                                BorderThickness="2"
                                CornerRadius="14"
                                Padding="8,6">
                            <Border.Effect>
                                <DropShadowEffect x:Name="thicknessShadow" BlurRadius="0" ShadowDepth="4" Direction="315" Color="#0F172A" Opacity="0.25"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Quick Presets -->
                                <RadioButton x:Name="sizeFine" GroupName="SizeGroup" Style="{StaticResource SizeRadioButtonStyle}" Click="Size_Click" Tag="2" ToolTip="Fine (2px)">
                                    <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </RadioButton>
                                <RadioButton x:Name="sizeMedium" GroupName="SizeGroup" Style="{StaticResource SizeRadioButtonStyle}" IsChecked="True" Click="Size_Click" Tag="5" ToolTip="Medium (5px)">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </RadioButton>
                                <RadioButton x:Name="sizeBold" GroupName="SizeGroup" Style="{StaticResource SizeRadioButtonStyle}" Click="Size_Click" Tag="12" ToolTip="Bold (12px)">
                                    <Ellipse Width="11" Height="11" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </RadioButton>

                                <!-- Mini Separator inside flyout -->
                                <Rectangle Width="1.5" Height="16" Fill="{DynamicResource ToolBtnBorder}" Margin="6,0,6,0" VerticalAlignment="Center"/>

                                <!-- Thickness Slider -->
                                <Slider x:Name="thicknessSlider"
                                        Style="{StaticResource NeoPopSliderStyle}"
                                        Minimum="1"
                                        Maximum="40"
                                        Value="5"
                                        Width="80"
                                        Margin="2,0,5,0"
                                        VerticalAlignment="Center"
                                        ValueChanged="ThicknessSlider_ValueChanged"
                                        ToolTip="Adjust stroke thickness (1px - 40px)"/>

                                <!-- Thickness Readout Badge -->
                                <Border Background="{DynamicResource BadgeBg}"
                                        BorderBrush="{DynamicResource BadgeBorder}"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Padding="5,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="txtThickness"
                                               Text="5px"
                                               Foreground="{DynamicResource BadgeTextFg}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Width="28"
                                               TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Separator -->
                <Rectangle x:Name="sep3" Style="{StaticResource HSeparatorStyle}"/>

                <!-- Actions (Undo, Redo, Clear, Toggle Visibility, Snapshot) -->
                <StackPanel x:Name="actionsPanel" Orientation="Horizontal">
                    <!-- Undo -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnUndo_Click" ToolTip="Undo (Ctrl+Z)">
                        <Path Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Redo -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnRedo_Click" ToolTip="Redo (Ctrl+Y)">
                        <Path Data="M18.4 10.6C16.55 8.99 14.15 8 11.5 8c-4.65 0-8.58 3.03-9.96 7.22L3.9 16c1.05-3.19 4.05-5.5 7.6-5.5 1.95 0 3.73.72 5.12 1.88L13 16h9V7l-3.6 3.6z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Clear Canvas -->
                    <Button x:Name="btnClear" Style="{StaticResource ToolbarButtonStyle}" Click="BtnClear_Click" ToolTip="Clear Screen (Ctrl+K)">
                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                              Fill="#F87171" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Toggle Visibility -->
                    <Button x:Name="btnToggleEye" Style="{StaticResource ToolbarButtonStyle}" Click="BtnToggleEye_Click" ToolTip="Hide / Show Drawings">
                        <Path x:Name="eyeIcon" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Board Mode Container with Split Button, Pagination & Flyout -->
                    <Grid x:Name="boardContainer" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Main Board Toggle Button -->
                            <Button x:Name="btnBoard"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="BtnBoard_Click"
                                    MouseRightButtonUp="BtnBoard_RightClick"
                                    ToolTip="Board Mode (B) — Click to toggle Whiteboard / Right-click or arrow for Styles"
                                    Margin="2,0,1,0"
                                    Padding="7">
                                <Path x:Name="boardIcon"
                                      Data="M20 3H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h4l-2 3v1h12v-1l-2-3h4c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 12H4V5h16v10z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>

                            <!-- Board Dropdown Chevron Button -->
                            <Button x:Name="btnBoardDropdown"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="BtnBoardDropdown_Click"
                                    ToolTip="Choose Board Style &amp; Layout"
                                    Margin="0,0,2,0"
                                    Padding="4,7"
                                    Width="18"
                                    MinWidth="18">
                                <Path x:Name="chevronBoard"
                                      Data="M1 1.5L4 4.5L7 1.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="7" Height="5"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"/>
                            </Button>

                            <!-- Board Slide Pagination Controls (Visible when in Board mode) -->
                            <Border x:Name="boardPagePanel"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource ToolBtnBg}"
                                    BorderBrush="{DynamicResource ToolBtnBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="2,1"
                                    Margin="2,0,2,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Prev Page Button -->
                                    <Button x:Name="btnPrevBoardPage"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Click="BtnPrevBoardPage_Click"
                                            ToolTip="Previous Board Page"
                                            Width="20" Height="22" Padding="2">
                                        <Path Data="M14 6L8 12L14 18"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="7" Height="9" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Page Indicator Badge -->
                                    <Border Background="{DynamicResource BadgeBg}"
                                            BorderBrush="{DynamicResource BadgeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4,1"
                                            Margin="2,0"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="txtBoardPage"
                                                   Text="1/1"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource BadgeTextFg}"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"/>
                                    </Border>

                                    <!-- Next Page Button -->
                                    <Button x:Name="btnNextBoardPage"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Click="BtnNextBoardPage_Click"
                                            ToolTip="Next Board Page"
                                            Width="20" Height="22" Padding="2">
                                        <Path Data="M10 6L16 12L10 18"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="7" Height="9" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Button>

                                    <!-- Add Blank Page Button -->
                                    <Button x:Name="btnAddBoardPage"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Click="BtnAddBoardPage_Click"
                                            ToolTip="Add New Blank Board Page"
                                            Width="20" Height="22" Padding="2"
                                            Margin="1,0,0,0">
                                        <Path Data="M12 5v14M5 12h14"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Board Popover Flyout -->
                        <Popup x:Name="boardPopup"
                               PlacementTarget="{Binding ElementName=boardContainer}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="True"
                               PopupAnimation="None"
                               VerticalOffset="8">
                            <Border x:Name="boardPopupBorder"
                                    Background="{DynamicResource PopupBg}"
                                    BorderBrush="{DynamicResource PopupBorder}"
                                    BorderThickness="2"
                                    CornerRadius="16"
                                    Padding="10"
                                    Width="236">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="0" ShadowDepth="5" Direction="315" Color="#0F172A" Opacity="0.25"/>
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="BOARD STYLE" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource PopupTitleFg}" Margin="4,0,0,6"/>

                                    <!-- Option: Desktop (Transparent) -->
                                    <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardStyle_Click" PreviewMouseLeftButtonDown="BtnBoardStyle_PreviewMouseDown" Tag="Transparent" ToolTip="Transparent Desktop pass-through">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H3V4h18v12z"
                                                  Fill="#64748B" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Desktop (Transparent)" Foreground="{DynamicResource PopupTextFg}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Option: Whiteboard -->
                                    <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardStyle_Click" PreviewMouseLeftButtonDown="BtnBoardStyle_PreviewMouseDown" Tag="Whiteboard" ToolTip="Clean White solid whiteboard">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="14" Height="14" Background="#FFFFFF" BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Plain Whiteboard" Foreground="{DynamicResource PopupTextFg}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Option: Grid / Graph Paper -->
                                    <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardStyle_Click" PreviewMouseLeftButtonDown="BtnBoardStyle_PreviewMouseDown" Tag="Grid" ToolTip="Engineering graph paper with square grid">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="M3 3v18h18V3H3zm8 16H5v-6h6v6zm0-8H5V5h6v6zm8 8h-6v-6h6v6zm0-8h-6V5h6v6z"
                                                  Fill="#0284C7" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Grid / Graph Paper" Foreground="{DynamicResource PopupTextFg}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Option: Ruled / Lined Paper -->
                                    <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardStyle_Click" PreviewMouseLeftButtonDown="BtnBoardStyle_PreviewMouseDown" Tag="Ruled" ToolTip="Notebook lined paper for writing notes">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="M3 5h18v2H3V5zm0 6h18v2H3v-2zm0 6h18v2H3v-2z"
                                                  Fill="#8B5CF6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Ruled Notebook" Foreground="{DynamicResource PopupTextFg}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Option: Dot Matrix -->
                                    <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardStyle_Click" PreviewMouseLeftButtonDown="BtnBoardStyle_PreviewMouseDown" Tag="Dots" ToolTip="Modern bullet-journal dot matrix">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="M6 6h2v2H6V6zm5 0h2v2h-2V6zm5 0h2v2h-2V6zM6 11h2v2H6v-2zm5 0h2v2h-2v-2zm5 0h2v2h-2v-2zM6 16h2v2H6v-2zm5 0h2v2h-2v-2zm5 0h2v2h-2v-2z"
                                                  Fill="#059669" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Dot Matrix Grid" Foreground="{DynamicResource PopupTextFg}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Option: Classroom Greenboard -->
                                    <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardStyle_Click" PreviewMouseLeftButtonDown="BtnBoardStyle_PreviewMouseDown" Tag="Greenboard" ToolTip="Classroom green chalkboard">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="14" Height="14" Background="#1B4D3E" BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Classroom Greenboard" Foreground="{DynamicResource PopupTextFg}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Option: Frosted Glass -->
                                    <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardStyle_Click" PreviewMouseLeftButtonDown="BtnBoardStyle_PreviewMouseDown" Tag="Frosted" ToolTip="Translucent frosted glass overlay">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="14" Height="14" Background="#90E2E8F0" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Frosted Glass (Dimmed)" Foreground="{DynamicResource PopupTextFg}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Separator -->
                                    <Rectangle Height="1.5" Fill="{DynamicResource SeparatorBrush}" Margin="2,6,2,6"/>

                                    <!-- Layout / Split Section -->
                                    <TextBlock Text="SCREEN LAYOUT" FontSize="10" FontWeight="ExtraBold" Foreground="{DynamicResource PopupTitleFg}" Margin="4,0,0,6"/>
                                    <UniformGrid Columns="3" Margin="0,0,0,2">
                                        <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardSplit_Click" PreviewMouseLeftButtonDown="BtnBoardSplit_PreviewMouseDown" Tag="Full" ToolTip="Full Screen Board" Margin="1,0" Padding="2,5">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Border Width="16" Height="12" Background="#E2E8F0" BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="2" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Full" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PopupTextFg}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardSplit_Click" PreviewMouseLeftButtonDown="BtnBoardSplit_PreviewMouseDown" Tag="SplitRight" ToolTip="Right Half Board, Left Desktop" Margin="1,0" Padding="2,5">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Grid Width="16" Height="12">
                                                    <Border BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="2"/>
                                                    <Border Width="8" Background="#38BDF8" HorizontalAlignment="Right" CornerRadius="0,2,2,0"/>
                                                </Grid>
                                                <TextBlock Text="Split ◨" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PopupTextFg}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ShapeMenuItemStyle}" Click="BtnBoardSplit_Click" PreviewMouseLeftButtonDown="BtnBoardSplit_PreviewMouseDown" Tag="SplitLeft" ToolTip="Left Half Board, Right Desktop" Margin="1,0" Padding="2,5">
                                            <StackPanel HorizontalAlignment="Center">
                                                <Grid Width="16" Height="12">
                                                    <Border BorderBrush="#0F172A" BorderThickness="1.5" CornerRadius="2"/>
                                                    <Border Width="8" Background="#38BDF8" HorizontalAlignment="Left" CornerRadius="2,0,0,2"/>
                                                </Grid>
                                                <TextBlock Text="Split ◧" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PopupTextFg}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Screen Spotlight Mode Toggle -->
                    <ToggleButton x:Name="btnSpotlight"
                                  Style="{StaticResource PresentationToggleButtonStyle}"
                                  Click="BtnSpotlight_Click"
                                  ToolTip="Screen Spotlight (Alt+F) — Dim background and highlight cursor">
                        <Path Data="M12 2A7 7 0 0 0 5 9c0 2.38 1.19 4.47 3 5.74V17a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7zm-1 15v-1h2v1h-2zm2-2.85V15h-2v-.85A5.002 5.002 0 0 1 7 9a5 5 0 0 1 10 0c0 2.1-1.3 3.89-3 4.15z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </ToggleButton>

                    <!-- Screen Magnifier / Live Zoom Toggle -->
                    <ToggleButton x:Name="btnMagnifier"
                                  Style="{StaticResource PresentationToggleButtonStyle}"
                                  Click="BtnMagnifier_Click"
                                  ToolTip="Screen Magnifier (Z) — 2× Live zoom loupe following cursor">
                        <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </ToggleButton>

                    <!-- Screenshot Tool (Clipboard & Save to PC) -->
                    <Grid x:Name="screenshotContainer">
                        <Button x:Name="btnScreenshot"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Padding="6,6"
                                Click="BtnScreenshot_Click"
                                ToolTip="Screenshot — Copy to Clipboard or Save to PC">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M9 2L7.17 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2h-3.17L15 2H9zm3 15c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z"
                                      Fill="#0284C7" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <Path x:Name="chevronScreenshot"
                                      Data="M1 1.5L4 4.5L7 1.5"
                                      Stroke="{DynamicResource ToolBtnFg}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="7" Height="5"
                                      Stretch="Uniform"
                                      Margin="3,1,0,0"
                                      VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Screenshot Options Popup -->
                        <Popup x:Name="screenshotPopup"
                               PlacementTarget="{Binding ElementName=btnScreenshot}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="None"
                               VerticalOffset="8">
                            <Border x:Name="screenshotPopupBorder"
                                    Background="{DynamicResource PopupBg}"
                                    BorderBrush="{DynamicResource PopupBorder}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Padding="8"
                                    Width="180">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="screenshotShadow" BlurRadius="0" ShadowDepth="5" Direction="315" Color="#0F172A" Opacity="0.30"/>
                                </Border.Effect>
                                <StackPanel Orientation="Vertical">
                                    <!-- Option 1: Copy to Clipboard -->
                                    <Button x:Name="btnCopyClipboard"
                                            Style="{StaticResource ShapeMenuItemStyle}"
                                            Click="BtnCopyClipboard_Click"
                                            ToolTip="Capture entire screen with drawings and copy to clipboard">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                  Fill="#0284C7" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="lblCopyClipboard"
                                                       Grid.Column="1"
                                                       Text="Copy to Clipboard"
                                                       Foreground="{DynamicResource PopupTextFg}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>


                                    <!-- Option 2: Save to PC -->
                                    <Button x:Name="btnSaveToPc"
                                            Style="{StaticResource ShapeMenuItemStyle}"
                                            Click="BtnSaveToPc_Click"
                                            ToolTip="Capture screen with drawings and save as PNG/JPG">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0"
                                                  Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2v9.67z"
                                                  Fill="#10B981" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="lblSaveToPc"
                                                       Grid.Column="1"
                                                       Text="Save to PC..."
                                                       Foreground="{DynamicResource PopupTextFg}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Separator -->
                <Rectangle x:Name="sep4" Style="{StaticResource HSeparatorStyle}"/>

                <!-- Settings & Window Controls -->
                <StackPanel x:Name="windowPanel" Orientation="Horizontal">
                    <!-- Settings -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnSettings_Click" ToolTip="Settings (Configure Hotkey &amp; Layout)">
                        <Image Source="icon/settings (1).png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    </Button>

                    <!-- Minimize to Tray -->
                    <Button x:Name="btnMinimize" Style="{StaticResource ToolbarButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimize to System Tray">
                        <Path Data="M20 14H4v-2h16v2z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <!-- Close -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="BtnClose_Click" ToolTip="Exit Scribo">
                        <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Fill="#EF4444" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
