<Window x:Class="Scribo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scribo Settings"
        Icon="app.ico"
        Width="490"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">

    <Window.Resources>
        <!-- Modern Neo-Pop Key-Capture Button Style -->
        <Style x:Key="KeyCaptureButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="keyBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="keyBorder" Property="Background" Value="#FEF08A"/>
                                <Setter TargetName="keyBorder" Property="BorderBrush" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="keyBorder" Property="Background" Value="#FDE047"/>
                                <Setter TargetName="keyBorder" Property="Margin" Value="0,1,0,-1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="mainBorder"
                Background="#FFFFFF"
                BorderBrush="#0F172A"
                BorderThickness="2"
                CornerRadius="16"
                Padding="18,16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="0" ShadowDepth="5" Direction="315" Color="#0F172A" Opacity="0.30"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header (Fixed Top) -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right"
                            Click="BtnClose_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="4">
                        <Path x:Name="btnClosePath" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                              Fill="#64748B" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="icon/settings (1).png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Margin="0,0,8,0"/>
                        <TextBlock x:Name="txtTitle" Text="Scribo Settings" FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A"/>
                    </StackPanel>
                </DockPanel>

                <!-- Scrollable Body -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0" Focusable="False">
                    <StackPanel>
                        <!-- ======================================================== -->
                        <!-- ⌨️ UNIFIED KEYBOARD SHORTCUTS & HOTKEYS SECTION        -->
                        <!-- ======================================================== -->
                        <Border x:Name="cardHotkeysGroup" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Padding="14,12" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Section Title with Reset Button -->
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right"
                                            Click="BtnResetHotkeys_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#4F46E5"
                                            FontWeight="Bold"
                                            FontSize="10.5"
                                            Cursor="Hand"
                                            Content="↺ Reset Defaults"
                                            ToolTip="Restore all shortcuts to factory defaults"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⌨️ KEYBOARD SHORTCUTS" FontWeight="ExtraBold" Foreground="#0F172A" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Part 1: System & Global Hotkeys -->
                                <TextBlock Text="GLOBAL HOTKEYS" FontSize="9.5" FontWeight="ExtraBold" Foreground="#64748B" Margin="0,0,0,6"/>

                                <!-- Summon Hotkey Row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Summon Scribo" FontWeight="SemiBold" Foreground="#1E293B" FontSize="11.5"/>
                                        <TextBlock Text="Restore toolbar from tray" Foreground="#64748B" FontSize="10"/>
                                    </StackPanel>
                                    <ComboBox x:Name="comboHotkey"
                                              Grid.Column="1"
                                              Background="#FFFFFF"
                                              Foreground="#0F172A"
                                              BorderBrush="#CBD5E1"
                                              BorderThickness="1.5"
                                              FontSize="11"
                                              Padding="6,4"
                                              Width="140"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Alt + S (Default)"/>
                                        <ComboBoxItem Content="F8"/>
                                        <ComboBoxItem Content="Ctrl + Shift + S"/>
                                        <ComboBoxItem Content="Ctrl + Alt + D"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Hold-to-Select Row -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="Hold-to-Select &amp; Move" FontWeight="SemiBold" Foreground="#1E293B" FontSize="11.5"/>
                                        <TextBlock Text="Hold key to temporarily select" Foreground="#64748B" FontSize="10"/>
                                    </StackPanel>
                                    <ComboBox x:Name="comboHoldKey"
                                              Grid.Column="1"
                                              Background="#FFFFFF"
                                              Foreground="#0F172A"
                                              BorderBrush="#CBD5E1"
                                              BorderThickness="1.5"
                                              FontSize="11"
                                              Padding="6,4"
                                              Width="140"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center">
                                        <ComboBoxItem Content="Alt (Default)"/>
                                        <ComboBoxItem Content="Ctrl"/>
                                        <ComboBoxItem Content="Shift"/>
                                        <ComboBoxItem Content="Space"/>
                                        <ComboBoxItem Content="Disabled"/>
                                    </ComboBox>
                                </Grid>

                                <Rectangle Height="1" Fill="#E2E8F0" Margin="0,0,0,10"/>

                                <!-- Part 2: Toolbar Tool Hotkeys -->
                                <TextBlock Text="TOOLBAR TOOL SHORTCUTS (Click box then press any key)" FontSize="9.5" FontWeight="ExtraBold" Foreground="#64748B" Margin="0,0,0,8"/>

                                <!-- 2-Column Grid of Tools with Key Capture Buttons -->
                                <UniformGrid Columns="2">
                                    <!-- Pen Tool -->
                                    <Grid Margin="0,0,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="✏️ Pen Tool" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyPen" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="P" Content="P"/>
                                    </Grid>

                                    <!-- Highlighter Tool -->
                                    <Grid Margin="6,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🖍️ Highlighter" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyHighlighter" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="H" Content="H"/>
                                    </Grid>

                                    <!-- Laser Pointer -->
                                    <Grid Margin="0,0,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⚡ Laser Pointer" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyLaser" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="L" Content="L"/>
                                    </Grid>

                                    <!-- Text Tool -->
                                    <Grid Margin="6,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="✍️ Text Note" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyText" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="T" Content="T"/>
                                    </Grid>

                                    <!-- Step Badge -->
                                    <Grid Margin="0,0,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔢 Step Badge" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyStepBadge" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="N" Content="N"/>
                                    </Grid>

                                    <!-- Shapes Tool -->
                                    <Grid Margin="6,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📐 Shapes Tool" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyShapes" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="R" Content="R"/>
                                    </Grid>

                                    <!-- Eraser Tool -->
                                    <Grid Margin="0,0,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🧹 Eraser" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyEraser" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="E" Content="E"/>
                                    </Grid>

                                    <!-- Select Tool -->
                                    <Grid Margin="6,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🎯 Select / Move" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeySelect" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="S" Content="S"/>
                                    </Grid>

                                    <!-- Board / Whiteboard -->
                                    <Grid Margin="0,0,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📋 Board Mode" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyBoard" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="B" Content="B"/>
                                    </Grid>

                                    <!-- Spotlight Focus -->
                                    <Grid Margin="6,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔦 Spotlight" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeySpotlight" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="F" Content="F"/>
                                    </Grid>

                                    <!-- Magnifier / Zoom -->
                                    <Grid Margin="0,0,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔍 Magnifier" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyMagnifier" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="M" Content="M"/>
                                    </Grid>

                                    <!-- Toggle Ink Visibility -->
                                    <Grid Margin="6,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="👁️ Hide/Show Ink" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyToggleInk" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="V" Content="V"/>
                                    </Grid>

                                    <!-- Clear Canvas -->
                                    <Grid Margin="0,0,6,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🗑️ Clear Canvas" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyClear" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="K" Content="K"/>
                                    </Grid>

                                    <!-- Copy Screenshot -->
                                    <Grid Margin="6,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📸 Screenshot" FontSize="11" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                        <Button x:Name="btnKeyScreenshot" Grid.Column="1" Style="{StaticResource KeyCaptureButtonStyle}" Click="HotkeyButton_Click" Tag="C" Content="C"/>
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Toolbar Orientation Card (Compact Inline Row) -->
                        <Border x:Name="cardOrientation" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📐 Orientation" FontWeight="Bold" Foreground="#0F172A" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <RadioButton x:Name="radioHorizontal"
                                                 GroupName="Orientation"
                                                 IsChecked="True"
                                                 Content="Horizontal"
                                                 Foreground="#1E293B"
                                                 FontWeight="SemiBold"
                                                 FontSize="11"
                                                 Margin="0,0,14,0"
                                                 Cursor="Hand"/>
                                    <RadioButton x:Name="radioVertical"
                                                 GroupName="Orientation"
                                                 Content="Vertical"
                                                 Foreground="#1E293B"
                                                 FontWeight="SemiBold"
                                                 FontSize="11"
                                                 Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Presentation & Teaching Aids Card (Compact) -->
                        <Border x:Name="cardPresentation" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🎯 Presentation &amp; Teaching Aids" FontWeight="Bold" Foreground="#0F172A" FontSize="12" Margin="0,0,0,7"/>
                                <CheckBox x:Name="chkKeystrokes" IsChecked="False" Content="Keystroke Visualizer (Display shortcuts on screen)" Foreground="#1E293B" FontSize="11" Margin="0,0,0,6"/>
                                <CheckBox x:Name="chkCursorHalo" IsChecked="False" Content="Cursor Halo &amp; Click Rings (Highlight mouse for audience)" Foreground="#1E293B" FontSize="11" Margin="0,0,0,6"/>
                                <CheckBox x:Name="chkVanishingLaser" IsChecked="True" Content="Vanishing Laser Ink (Smoothly fade marks after 2s)" Foreground="#1E293B" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Minimize Options Card (Compact) -->
                        <Border x:Name="cardMinimize" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="10" Padding="12,9" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="🗕 Minimize Behavior" FontWeight="Bold" Foreground="#0F172A" FontSize="12" Margin="0,0,0,7"/>
                                <CheckBox x:Name="chkTray" IsChecked="True" Content="Minimize to Windows System Tray" Foreground="#1E293B" FontSize="11" Margin="0,0,0,6"/>
                                <CheckBox x:Name="chkNotify" IsChecked="True" Content="Show notification banner on minimize" Foreground="#1E293B" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Quick Tips Card (Compact Pill) -->
                        <Border x:Name="cardTips" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="10" Padding="10,8" Margin="0,0,0,8">
                            <TextBlock Text="💡 Tip: Click any shortcut box above, then press a key on your keyboard to instantly rebind it!" Foreground="#1E40AF" FontSize="10.5" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Save Button (Fixed Bottom) -->
                <DockPanel Grid.Row="2" Margin="0,10,0,0">
                    <Button Content="Save &amp; Close"
                            Click="BtnSave_Click"
                            HorizontalAlignment="Right"
                            Background="#FFE600"
                            BorderBrush="#0F172A"
                            BorderThickness="2"
                            Foreground="#0F172A"
                            FontWeight="Bold"
                            FontSize="11.5"
                            Padding="18,7"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
